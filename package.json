{
  "name": "vello-tech",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:import-firestore": "tsx scripts/import-firestore.ts",
    "storage:import-firebase": "tsx scripts/import-firebase-storage.ts",
    "storage:map-images": "tsx scripts/import-firebase-storage.ts --map-only",
    "storage:organize": "tsx scripts/reorganize-neon-storage.ts",
    "migration:audit": "tsx scripts/audit-neon-migration.ts",
    "migration:code-audit": "tsx scripts/audit-code-migration.ts",
    "test:auth-integration": "tsx scripts/test-auth-integration.ts",
    "migration:verify": "npm run migration:code-audit && npm run migration:audit && npm run typecheck && npm run lint && npm run build",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build && next typegen",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "cloudflare:check": "vinext check",
    "cloudflare:typegen": "node -e \"require('node:fs').mkdirSync('.wrangler',{recursive:true})\" && wrangler types --env-interface CloudflareEnv .wrangler/cloudflare-env.d.ts",
    "build:cloudflare": "npm run build:vinext",
    "preview:cloudflare": "npm run build:vinext && npm run start:vinext",
    "deploy:cloudflare": "npm run deploy:vinext"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
